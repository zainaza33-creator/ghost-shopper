## 4. Firestore data model

Region: `africa-south1`. All timestamps are Firestore Timestamps unless noted.

### `users/{uid}`

```js
{
  name: string,               // optional, added on account page
  phone: string,              // e.g. "+27821234567"
  email: string,              // optional
  role: "customer" | "driver" | "admin",
  savedAddresses: [
    { street, lat, lng, savedAt, isDefault }
  ],
  walletBalance: number,      // ZAR, credits from unavailable items
  notificationsEnabled: boolean,
  fcmTokens: [string],        // FCM device tokens
  isOnline: boolean,          // drivers only
  lastSeen: Timestamp,        // drivers only
  approved: boolean,          // drivers only
  suspended: boolean,         // drivers only
  area: string,               // drivers only — delivery area
  createdAt, updatedAt
}
```

### `stores/{storeId}`

```js
{
  name: string,
  category: string,           // "supermarket" | "butchery" | "bakery" | "pharmacy" | "other"
  categories: [string],       // optional — multi-category support
  address: string,
  phone: string,
  whatsappPrimary: string,
  whatsappSecondary: string,  // optional
  logo: string,               // URL
  description: string,
  hours: string,              // "Mon-Fri 7:30am-6pm, Sat 7am-6pm, Sun 7:30am-5pm"
  popular: boolean,
  tags: [string],
  flyers: [{ image, title }],
  temporarilyClosed: boolean,
  area: string,               // e.g. "Verulam"
  deliveryFee: number,        // optional, overrides default
  createdAt, updatedAt
}
```

**Important — hours format:** always `"Mon-Fri 7:30am-6pm, Sat 7am-6pm, Sun 7:30am-5pm"`. The homepage and checkout both parse this to compute "Open now" status.

### `products/{productId}`

```js
{
  name: string,
  storeId: string,
  category: string,
  desc: string,
  weight: string,             // "500g", "1kg"
  price: number,
  oldPrice: number | null,    // for specials
  image: string,
  images: [string],           // additional images
  stock: boolean,             // false = out of stock
